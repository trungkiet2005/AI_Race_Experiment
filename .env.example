# Copy to .env and fill in only the providers you actually run.
# .env is gitignored; never commit a filled-in copy.
#
# The offline/local engine needs none of these. They are read by
# ai_race/models/*_direct.py through python-dotenv (pip install -e ".[api]").

# --- Hosted model providers -------------------------------------------------
API_KEY_OPENAI=
API_KEY_ANTHROPIC=
API_KEY_MISTRAL=
GEMINI_API_KEY=

# --- AWS Bedrock ------------------------------------------------------------
# Either a Bedrock bearer token, or a normal AWS profile / access key pair.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Kaggle model proxy ("backend": "proxy") --------------------------------
# Written by `kaggle benchmarks auth`; the token is short-lived, so refresh it
# rather than hand-editing these.
MODEL_PROXY_URL=
MODEL_PROXY_API_KEY=
MODEL_PROXY_EXPIRY_TIME=

# --- Kaggle Benchmark runs (pip install -e ".[kaggle-benchmark]") -----------
# KAGGLE_USERNAME=
# KAGGLE_KEY=
# BUCKET_NAME=
